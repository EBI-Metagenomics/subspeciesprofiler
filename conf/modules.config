/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ------------------------------------------------------------------------ //
    //  Subspecies clustering (PopPUNK staged model selection + FastANI)        //
    //  publishDir publishes the whole output directory of each step, so the    //
    //  PopPUNK diagnostic plots (*.png / *.pdf) are always published.          //
    // ------------------------------------------------------------------------ //

    withName: 'SPECIESQC' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/speciesqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_CREATEDB' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/createdb" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_QCDB' {
        // Stage 0 QC: remove genomes failing PopPUNK's distance/length/ambiguity checks
        // (defaults: core > 0.1, accessory > 0.5, zero-distance-proportion > 0.05). Tune with
        // e.g. `--max-a-dist`, `--max-pi-dist`, `--max-zero-dist` via ext.args if the defaults
        // over-prune. Do NOT add `--qc-keep`: it hits a PopPUNK 2.7.8 bug (UnboundLocalError in
        // remove_qc_fail) whenever any sample fails QC. (`--auto-max-dists` is also not a 2.7.8 flag.)
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/qcdb" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_QUANTILES' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/quantiles" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTANI_ALLVSALL' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/fastani" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_FITMODEL|POPPUNK_REFINE_DBSCAN' {
        // One process (aliased for the dbscan refine) covers every fit: the model spec is supplied
        // per-task via the module's fit_args input; a sub-directory per fit (meta.model) keeps the
        // sweep + refine outputs distinct.
        // A degenerate grid point (a bad --K/--D/--min-cluster-prop) makes PopPUNK error
        // deterministically; ignore it so that single fit is simply absent from the ranking rather
        // than failing the whole species (retrying wouldn't help). Only genuinely transient/resource
        // failures (signals, connection resets) are retried, escalating resources via base.config.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/fitmodel/${meta.model ?: 'model'}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_REFINE_DBSCAN' {
        // A distinct output name from the seeding dbscan fit (`<id>_fitmodel`), so the refined
        // model's files are self-describing and never shadow the seed's.
        ext.prefix = { "${meta.id}_refine" }
    }


    withName: 'POPPUNK_VISUALISE' {
        // Every Strong/Moderate fit publishes into ONE shared per-species microreact directory,
        // so the model name (family + swept params) is carried in each filename instead of a
        // per-model sub-directory -- see the `prefix` in the module.
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/microreact" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_EVALUATE|POPPUNK_EVALUATE_DBSCAN_REFINE|SYNTRACKER_EVALUATE' {
        ext.args   = '--min-ani 0.90 --accept-status Strong --min-comparison-cluster-size 2'
        // Ignore an evaluation that errors deterministically (e.g. a degenerate clustering the
        // evaluator can't score) so it drops out of the ranking instead of failing the species;
        // only transient/resource failures are retried.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/evaluate/${meta.model ?: 'model'}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'ANI_PLOT' {
        // <outdir>/<species>/<species>_ani_overview.{png,pdf,tsv}, next to poppunk/, speciesqc/, syntracker/.
        // A plot never stops a species: only resource/kill exits retry, anything else is ignored.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'ignore' }
        // The poppunk image is linux/amd64 only; ask Docker for it explicitly (e.g. on Apple Silicon).
        containerOptions = { workflow.containerEngine == 'docker' ? '--platform linux/amd64' : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ---- SynTracker branch: <outdir>/<species>/syntracker/ ----

    withName: 'SEQKIT_STATS' {
        // N50 of the HQ genomes, for the SynTracker reference floor and the target cap.
        ext.args   = '--all'
        publishDir = [ enabled: false ]
    }

    withName: 'SYNTRACKER_SELECT' {
        // Reference = most central HQ genome (mean FastANI) with N50 >= the floor; targets = every
        // HQ genome (reference first, then by N50), capped only when --syntracker_max_targets > 0.
        ext.args   = { "--min-n50 ${params.syntracker_ref_min_n50} --max-targets ${params.syntracker_max_targets}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/syntracker/selection" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SYNTRACKER_RUN' {
        // One task per chunk pair (see SYNTRACKER_METHODS): ~40 core-hours for 150 targets, the most
        // a job gets at the default --syntracker_chunk_size 75; cost grows with the square of the targets.
        cpus          = { 16 }
        memory        = { 64.GB * task.attempt }
        time          = { 24.h * task.attempt }
        // Every chunk job is needed (a missing one would leave its pairs out of the merge), so retry
        // harder than the fits: resource/kill exits up to twice, escalating memory and time with
        // task.attempt; any other exit (an R worker crash, a node or filesystem fault) once. After
        // that, 'ignore': the species gets no SynTracker rows (SYNTRACKER_METHODS warns, naming the
        // failed chunks) but its PopPUNK results are kept. `-resume` re-runs only the failed jobs.
        // 'retry' past maxRetries would stop the whole pipeline, hence the explicit attempt checks.
        errorStrategy = {
            def resource = task.exitStatus in ((130..145) + 104)
            task.attempt <= ( resource ? 2 : 1 ) ? 'retry' : 'ignore'
        }
        maxRetries    = 2
        // The image is linux/amd64 only; ask Docker for it explicitly (e.g. on Apple Silicon).
        // Singularity has no such option and runs the amd64 image natively on x86_64 clusters.
        containerOptions = { workflow.containerEngine == 'docker' ? '--platform linux/amd64' : '' }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/syntracker/apss/${meta.chunk}" },
            mode: params.publish_dir_mode,
            // Each job's APSS tables and SynTracker log, flat under apss/<chunk>/ ('all' when unchunked);
            // the per-region table is several GB, keep it in work/
            // (blast_output/ and the names dictionary only feed SYNTRACKER_FILTER)
            saveAs: { filename ->
                def skip = filename.endsWith('synteny_scores_per_region.csv') || filename.endsWith('blast_output') ||
                    filename.endsWith('sample_names_dictionary.tab') || filename.equals('versions.yml')
                skip ? null : filename.tokenize('/')[-1]
            }
        ]
    }

    withName: 'SYNTRACKER_FILTER' {
        // SynTracker's one-hit-per-genome rule, applied to each job before the merge. Like the
        // merge, any failure other than a resource/kill exit stops the run: it means the job's
        // output is not what SynTracker should have written, and must not be skipped silently.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : 'terminate' }
        maxRetries    = 1
        publishDir = [
            path: { "${params.outdir}/${meta.id}/syntracker/apss/${meta.chunk}" },
            mode: params.publish_dir_mode,
            // only the report: the filtered tables are merged into apss/avg_synteny_scores_all_regions.csv
            saveAs: { filename -> filename.endsWith('_syntracker_multihit.tsv') ? filename : null }
        ]
    }

    withName: 'SYNTRACKER_MERGE' {
        // The species' all-regions APSS, merged over the jobs, next to the per-job folders. Strict on
        // purpose: a pair that differs between jobs fails it, and (base errorStrategy) stops the run.
        publishDir = [
            path: { "${params.outdir}/${meta.id}/syntracker/apss" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SYNTRACKER_CLUSTERS' {
        ext.args = { [
            "--min-regions ${params.syntracker_min_regions}",
            "--min-genome-coverage ${params.syntracker_min_genome_coverage}",
            "--min-apss ${params.syntracker_min_apss}",
            "--apss-range ${params.syntracker_apss_range}",
            "--apss-steps ${params.syntracker_apss_steps}",
            "--resolutions ${params.syntracker_resolutions}",
            "--seed ${params.syntracker_seed}",
        ].join(' ') }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/syntracker/clusters" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'SYNTRACKER_EVALUATE' {
        // errorStrategy comes from the shared POPPUNK_EVALUATE selector above. The APSS inputs put
        // the evaluator in APSS space (the module adds --distance apss); pairs on fewer regions
        // than the clustering step's filter are treated as missing there too.
        ext.args = { "--min-ani 0.90 --accept-status Strong --min-comparison-cluster-size 2 --min-regions ${params.syntracker_min_regions}" }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/syntracker/evaluate/${meta.model ?: 'model'}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
