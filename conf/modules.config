/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    publishDir = [
        path: { "${params.outdir}/${task.process.tokenize(':')[-1].tokenize('_')[0].toLowerCase()}" },
        mode: params.publish_dir_mode,
        saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
    ]

    withName: 'MULTIQC' {
        ext.args   = { params.multiqc_title ? "--title \"$params.multiqc_title\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    // ------------------------------------------------------------------------ //
    //  Subspecies clustering (PopPUNK staged model selection + FastANI)        //
    //  publishDir publishes the whole output directory of each step, so the    //
    //  PopPUNK diagnostic plots (*.png / *.pdf) are always published.          //
    // ------------------------------------------------------------------------ //

    withName: 'SPECIESQC' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/speciesqc" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_CREATEDB' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/createdb" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_QCDB' {
        // Stage 0 QC: remove genomes failing PopPUNK's distance/length/ambiguity checks
        // (defaults: core > 0.1, accessory > 0.5, zero-distance-proportion > 0.05). Tune with
        // e.g. `--max-a-dist`, `--max-pi-dist`, `--max-zero-dist` via ext.args if the defaults
        // over-prune. Do NOT add `--qc-keep`: it hits a PopPUNK 2.7.8 bug (UnboundLocalError in
        // remove_qc_fail) whenever any sample fails QC. (`--auto-max-dists` is also not a 2.7.8 flag.)
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/qcdb" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_QUANTILES' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/quantiles" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'FASTANI_ALLVSALL' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/fastani" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_FITMODEL' {
        // The model spec is supplied per-task via the module's fit_args input; a
        // sub-directory per fit (meta.model) keeps the sweep outputs distinct.
        // A degenerate grid point (a bad --K/--D/--min-cluster-prop) can make PopPUNK error;
        // retry once (resource/transient), then ignore so that single fit is simply absent from
        // the ranking rather than failing the whole species.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : (task.attempt <= 1 ? 'retry' : 'ignore') }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/fitmodel/${meta.model ?: 'model'}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_LINEAGE_RANKS' {
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/lineage_ranks" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

    withName: 'POPPUNK_EVALUATE' {
        ext.args   = '--min-ani 0.90 --accept-status Strong --min-comparison-cluster-size 2'
        // Ignore an evaluation that fails after one retry (e.g. a degenerate clustering the
        // evaluator can't score) so it drops out of the ranking instead of failing the species.
        errorStrategy = { task.exitStatus in ((130..145) + 104) ? 'retry' : (task.attempt <= 1 ? 'retry' : 'ignore') }
        publishDir = [
            path: { "${params.outdir}/${meta.id}/poppunk/evaluate/${meta.model ?: 'model'}" },
            mode: params.publish_dir_mode,
            saveAs: { filename -> filename.equals('versions.yml') ? null : filename }
        ]
    }

}
