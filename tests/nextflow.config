/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
*/

// Cap resources so module/pipeline nf-tests run on modest machines and CI (the tiny test data
// never needs the full process_* labels from conf/base.config).
process {
    resourceLimits = [
        cpus: 4,
        memory: '12.GB',
        time: '1.h'
    ]
}

params {
    modules_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/modules/data/'
    pipelines_testdata_base_path = 'https://raw.githubusercontent.com/nf-core/test-datasets/refs/heads/subspeciesprofiler'
}

aws.client.anonymous = true // fixes S3 access issues on self-hosted runners
