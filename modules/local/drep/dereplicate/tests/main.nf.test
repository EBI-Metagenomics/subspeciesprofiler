nextflow_process {

    name "Test Process DREP_DEREPLICATE"
    script "../main.nf"
    process "DREP_DEREPLICATE"

    tag "modules"
    tag "modules_local"
    tag "drep"
    tag "drep/dereplicate"
    config "./nextflow.config"

    test("two genomes - genome info") {

        when {
            params {
                module_args = '-l 1000 -sa 0.95'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + "genomics/prokaryotes/candidatus_portiera_aleyrodidarum/genome/genome.fasta", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/prokaryotes/escherichia_coli/genome/genome.fa", checkIfExists: true),
                    ],
                    file("${projectDir}/tests/fixtures/drep/genomeinfo.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert process.out.summary_tables[0][1].collect { file(it).name }.contains('genomeInformation.csv') },
                { assert snapshot(
                    process.out.summary_tables[0][1].collect { path(it).readLines().size() },
                    process.out.fastas,
                    path(process.out.log[0][1]).readLines().any { it.contains('Finished the dereplicate operation') },
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("two genomes - genome info - stub") {

        options "-stub"

        when {
            params {
                module_args = '-l 1000 -sa 0.95'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    [
                        file(params.modules_testdata_base_path + "genomics/prokaryotes/candidatus_portiera_aleyrodidarum/genome/genome.fasta", checkIfExists: true),
                        file(params.modules_testdata_base_path + "genomics/prokaryotes/escherichia_coli/genome/genome.fa", checkIfExists: true),
                    ],
                    file("${projectDir}/tests/fixtures/drep/genomeinfo.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
