nextflow_process {

    name "Test Process SYNTRACKER_CLUSTERS"
    script "../main.nf"
    process "SYNTRACKER_CLUSTERS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "syntracker"
    tag "syntracker/clusters"

    // Fixture: groups A (5 genomes) and B (4) with one high-APSS bridging pair between them, all
    // pairs on 120 regions (all-regions table), and the 40-region table for the noise estimate.
    // genomeC1 is a target without any pair: low coverage, so it is excluded.
    test("syntracker apss - all regions - leiden") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/avg_synteny_scores_all_regions.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/avg_synteny_scores_40_regions.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/targets.txt", checkIfExists: true)
                ]
                """
            }
        }

        then {
            // Taxon,Cluster rows of each table, keyed by file name
            def tables = process.out.clusters[0][1].collectEntries { f ->
                [ file(f.toString()).name, path(f.toString()).readLines().drop(1)*.tokenize(',') ]
            }
            def at80     = tables['test_syntracker_leiden_apss0.80_r1.0_clusters.csv'].collectEntries { [ it[0], it[1] ] }
            def coverage = path(process.out.coverage[0][1].toString()).readLines().drop(1)*.tokenize('\t').collectEntries { [ it[0], it[-1] ] }
            assertAll(
                { assert process.success },
                { assert tables.keySet() == [ 'test_syntracker_leiden_apss0.70_r1.0_clusters.csv',
                                              'test_syntracker_leiden_apss0.80_r1.0_clusters.csv' ] as Set },
                // the bridging pair does not merge the groups
                { assert at80['genomeA1'] != at80['genomeB1'] },
                { assert at80['genomeA1'] == at80['genomeA5'] },
                // a target without pairs has no coverage and is left out of the clusterings
                { assert coverage['genomeC1'] == 'low_coverage' },
                { assert !at80.containsKey('genomeC1') },
                { assert snapshot(
                    process.out.clusters,
                    process.out.coverage,
                    process.out.noise,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("syntracker apss - all regions - leiden - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/avg_synteny_scores_all_regions.csv", checkIfExists: true),
                    [],
                    file("${projectDir}/tests/fixtures/syntracker/targets.txt", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
