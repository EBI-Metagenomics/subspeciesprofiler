nextflow_process {

    name "Test Process SYNTRACKER_CLUSTERS"
    script "../main.nf"
    process "SYNTRACKER_CLUSTERS"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "syntracker"
    tag "syntracker/clusters"

    // Fixture: groups A (5 genomes) and B (4) with one high-APSS bridging pair between them,
    // plus genomeC1, labelled but absent from the APSS table.
    test("syntracker apss - average linkage") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/avg_synteny_scores_all_regions.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/labels.csv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            // Taxon,Cluster rows of each table, keyed by file name
            def tables = process.out.clusters[0][1].collectEntries { f ->
                [ file(f.toString()).name, path(f.toString()).readLines().drop(1)*.tokenize(',') ]
            }
            def at80   = tables['test_syntracker_avg_apss0.80_clusters.csv'].collectEntries { [ it[0], it[1] ] }
            assertAll(
                { assert process.success },
                { assert tables.keySet() == [ 'test_syntracker_avg_apss0.70_clusters.csv', 'test_syntracker_avg_apss0.80_clusters.csv' ] as Set },
                // the bridging pair does not merge the groups under average linkage
                { assert at80['genomeA1'] != at80['genomeB1'] },
                { assert at80['genomeA1'] == at80['genomeA5'] },
                // labelled genome without APSS pairs is reported as a singleton
                { assert at80.containsKey('genomeC1') },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("syntracker apss - average linkage - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/avg_synteny_scores_all_regions.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/labels.csv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
