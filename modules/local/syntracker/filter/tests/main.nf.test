nextflow_process {

    name "Test Process SYNTRACKER_FILTER"
    script "../main.nf"
    process "SYNTRACKER_FILTER"

    tag "modules"
    tag "modules_local"
    tag "syntracker"
    tag "syntracker/filter"

    // Fixture: genomeA, genomeB, genomeC on regions R1-R3 (scores 0.9, 0.5, 0.8); genomeB has two
    // BLAST hits in R2, so its pairs lose R2 and genomeA / genomeC keeps all three regions.
    test("syntracker filter - multi-hit genome loses the region") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', chunk:'c1_c2' ],
                    file("${projectDir}/tests/fixtures/syntracker/filter/synteny_scores_per_region.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/filter/blast_output", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/filter/sample_names_dictionary.tab", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def apss = path(process.out.apss[0][1].toString()).readLines().drop(1)*.tokenize(',')
                .collectEntries { [ "${it[1]}/${it[2]}".replace('"', ''), [ it[3] as double, it[4] as int ] ] }
            assertAll(
                { assert process.success },
                { assert apss['genomeA/genomeB'][1] == 2 && Math.abs(apss['genomeA/genomeB'][0] - 0.85) < 1e-12 },
                { assert apss['genomeB/genomeC'][1] == 2 },
                { assert apss['genomeA/genomeC'][1] == 3 && Math.abs(apss['genomeA/genomeC'][0] - 2.2d / 3d) < 1e-12 },
                { assert snapshot(
                    process.out.apss,
                    process.out.report,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("syntracker filter - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', chunk:'c1_c2' ],
                    file("${projectDir}/tests/fixtures/syntracker/filter/synteny_scores_per_region.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/filter/blast_output", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/filter/sample_names_dictionary.tab", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                // one row per pair, as in the real run
                { assert path(process.out.apss[0][1].toString()).readLines().size() == 1 + 3 },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
