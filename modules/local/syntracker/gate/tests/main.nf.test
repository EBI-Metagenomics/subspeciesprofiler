nextflow_process {

    name "Test Process SYNTRACKER_GATE"
    script "../main.nf"
    process "SYNTRACKER_GATE"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "syntracker"
    tag "syntracker/gate"

    // Fixture (N50 / N90): genome1 HQ 250 kb / 50 kb, genome2 HQ 8 kb / 2 kb,
    // genome3 MQ 90 kb / 20 kb, genome4 HQ 3 kb / 0.8 kb.
    test("syntracker gate - N50") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/gate/seqkit_stats.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/gate/rfile.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/gate/labels.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.stats[0][1].toString()).readLines().drop(1).collect { it.tokenize('\t')[0] } == [ 'genome1.fna.gz', 'genome2.fna.gz', 'genome3.fna.gz' ] },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("syntracker gate - N90 (strict)") {

        when {
            params {
                module_args_metric = 'N90'
            }
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/gate/seqkit_stats.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/gate/rfile.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/gate/labels.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert path(process.out.stats[0][1].toString()).readLines().drop(1).collect { it.tokenize('\t')[0] } == [ 'genome1.fna.gz', 'genome3.fna.gz' ] },
                { assert snapshot(process.out).match() }
            )
        }

    }

    test("syntracker gate - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/gate/seqkit_stats.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/gate/rfile.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/gate/labels.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
