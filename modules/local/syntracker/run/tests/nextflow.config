// The SynTracker image is linux/amd64 only (its pinned R 4.0 / DECIPHER 2.18 stack has no arm64
// build). Request amd64 explicitly so the test also runs under emulation on Apple Silicon;
// on x86_64 runners this is a no-op.
docker.runOptions = '--platform linux/amd64'

process {
    withName: 'SYNTRACKER_RUN' {
        // Keep the real test light: a few cores, and SynTracker's default region settings.
        cpus   = 4
        memory = 8.GB
    }
}
