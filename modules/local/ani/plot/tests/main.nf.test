nextflow_process {

    name "Test Process ANI_PLOT"
    script "../main.nf"
    process "ANI_PLOT"
    config "./nextflow.config"

    tag "modules"
    tag "modules_local"
    tag "ani"
    tag "ani/plot"

    // Fixture: 6 genomes in two groups (99.5% ANI within, 96% between, the two FastANI directions
    // differing by 0.1), one MQ genome, and one pair (gA1 / gB3) without a FastANI hit.
    test("ani plot - two groups, one missing pair") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/ani_plot/fastani.txt", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/ani_plot/labels.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            def summary = path(process.out.summary[0][1].toString()).readLines()*.tokenize('\t')
            def stats   = [ summary[0], summary[1] ].transpose().collectEntries()
            assertAll(
                { assert process.success },
                { assert file(process.out.png[0][1].toString()).size() > 10000 },
                { assert file(process.out.pdf[0][1].toString()).size() > 1000 },
                { assert stats.n_genomes == '6' && stats.n_pairs == '14' && stats.n_missing_pairs == '1' },
                // PNG/PDF bytes are not reproducible (fonts, timestamps): snapshot their names only
                { assert snapshot(
                    process.out.summary,
                    file(process.out.png[0][1].toString()).name,
                    file(process.out.pdf[0][1].toString()).name,
                    process.out.findAll { key, val -> key.startsWith('versions') }
                ).match() }
            )
        }

    }

    test("ani plot - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/ani_plot/fastani.txt", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/ani_plot/labels.csv", checkIfExists: true)
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
