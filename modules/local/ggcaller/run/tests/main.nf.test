nextflow_process {

    name "Test Process GGCALLER"
    script "../main.nf"
    process "GGCALLER"

    tag "modules"
    tag "modules_local"
    tag "ggcaller"
    tag "ggcaller/run"

    // Fixture: five S. pneumoniae CPS loci (~25 kb each, from ggCaller's own tests), files
    // <accession>.fa.gz, r-file samples <accession>. ggCaller names them <accession>.fa.
    test("ggcaller - five cps loci") {

        setup {
            run("GGCALLER_DOWNLOADDB") {
                script "../../downloaddb/main.nf"
            }
        }

        when {
            process {
                """
                def samples = [ 'CR931658', 'CR931659', 'CR931660', 'CR931717', 'CR931719' ]
                input[0] = [
                    [ id:'test' ],
                    samples.collect { file("${projectDir}/tests/fixtures/pangenome/genomes/\${it}.fa.gz", checkIfExists: true) },
                    file("${projectDir}/tests/fixtures/pangenome/rfile.tsv", checkIfExists: true)
                ]
                input[1] = GGCALLER_DOWNLOADDB.out.db
                """
            }
        }

        then {
            def samples = [ 'CR931658', 'CR931659', 'CR931660', 'CR931717', 'CR931719' ]
            def gffs    = process.out.gff[0][1].collect { file(it.toString()) }
            def faas    = process.out.proteins[0][1].collect { file(it.toString()) }
            def ffns    = process.out.genes[0][1].collect { file(it.toString()) }
            def lines   = { f -> path(f.toString()).linesGzip }
            assertAll(
                { assert process.success },
                // one gzipped GFF per r-file sample, named after the sample, each with the FASTA for Panaroo
                { assert gffs*.name.sort() == samples.collect { "${it}.gff.gz" } },
                { assert gffs.every { g -> lines(g).contains('##FASTA') } },
                { assert gffs.every { g -> lines(g).findAll { it.contains('\tCDS\t') }.every { it.contains("ID=${g.name - '.gff.gz'}_") } } },
                // one gzipped protein and CDS file per sample, each holding only that sample's genes
                { assert faas*.name.sort() == samples.collect { "${it}.faa.gz" } },
                { assert ffns*.name.sort() == samples.collect { "${it}.ffn.gz" } },
                { assert (faas + ffns).every { f ->
                    def headers = lines(f).findAll { it.startsWith('>') }
                    headers.size() > 0 && headers.every { it.startsWith(">${f.name.tokenize('.')[0]}_") } } },
                // the protein and CDS files hold the same genes
                { assert samples.every { s ->
                    lines(faas.find { it.name == "${s}.faa.gz" }).findAll { it.startsWith('>') } ==
                        lines(ffns.find { it.name == "${s}.ffn.gz" }).findAll { it.startsWith('>') } } },
                { assert snapshot(process.out.versions_ggcaller).match() }
            )
        }

    }

    test("ggcaller - stub") {

        options "-stub"

        setup {
            run("GGCALLER_DOWNLOADDB") {
                script "../../downloaddb/main.nf"
            }
        }

        when {
            process {
                """
                def samples = [ 'CR931658', 'CR931659', 'CR931660', 'CR931717', 'CR931719' ]
                input[0] = [
                    [ id:'test' ],
                    samples.collect { file("${projectDir}/tests/fixtures/pangenome/genomes/\${it}.fa.gz", checkIfExists: true) },
                    file("${projectDir}/tests/fixtures/pangenome/rfile.tsv", checkIfExists: true)
                ]
                input[1] = GGCALLER_DOWNLOADDB.out.db
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
