nextflow_process {

    name "Test Process GGCALLER_DOWNLOADDB"
    script "../main.nf"
    process "GGCALLER_DOWNLOADDB"

    tag "modules"
    tag "modules_local"
    tag "ggcaller"
    tag "ggcaller/downloaddb"

    // Downloads ~120 MB from ftp.ebi.ac.uk.
    test("ggcaller downloaddb") {

        when {
            process {
                """
                """
            }
        }

        then {
            def db = process.out.db[0].toString()
            assertAll(
                { assert process.success },
                { assert file("${db}/ggCallerdb.tar.bz2").exists() },
                { assert file("${db}/ggCallerdb/balrog_models").isDirectory() },
                { assert snapshot(process.out.versions_ggcaller).match() }
            )
        }

    }

    test("ggcaller downloaddb - stub") {

        options "-stub"

        when {
            process {
                """
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }

}
