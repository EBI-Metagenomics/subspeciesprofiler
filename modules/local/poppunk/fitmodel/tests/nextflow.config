/*
 * `mamba env create` (the default conda frontend Nextflow picks when invoked
 * via the `mamba` profile) blocks forever inside `mamba::Console::prompt()`
 * waiting on a confirmation read from stdin that Nextflow's subprocess pipe
 * never supplies, when spawned as a Nextflow child process (confirmed via
 * process backtrace sampling; reproduces even though Nextflow already passes
 * `--yes`). This affected both the `+mamba` and default `+conda` profiles on
 * this machine.
 *
 * `micromamba` does not exhibit this hang and resolves the exact same
 * environment.yml correctly and quickly, so it's used here instead.
 */
conda.useMicromamba = true

/*
 * On Apple Silicon (arm64), conda-forge/bioconda's native osx-arm64 build of
 * graph-tool has a broken `label_components` dispatch that crashes any
 * `poppunk --fit-model` run right after the model fit completes, with:
 * `RuntimeError: No static implementation was found for the desired
 * routine. This is a graph_tool bug.` This is a platform-specific upstream
 * packaging bug, not a module bug (createdb/qcdb don't hit it because they
 * don't call into graph-tool).
 *
 * The fix is to force micromamba to build an osx-64 (x86_64) environment
 * instead - transparently run through Rosetta 2 - which uses graph-tool's
 * x86_64 build and does not have this bug. `conda.createOptions =
 * '--platform osx-64'` was tried here but Nextflow does NOT forward
 * `conda.createOptions` to the `micromamba create` command it runs (verified:
 * the resulting env's python binary was still arm64 Mach-O with that config
 * set), so it cannot be pinned from this file alone.
 *
 * Instead, on Apple Silicon, export CONDA_SUBDIR=osx-64 in the shell before
 * invoking nf-test/nextflow - this env var IS honoured by micromamba (it is
 * inherited by the env-creation subprocess Nextflow spawns) and reliably
 * produces an x86_64 env:
 *
 *   export CONDA_SUBDIR=osx-64
 *   nf-test test modules/local/poppunk/fitmodel/tests/main.nf.test --profile +conda
 *
 * On native x86_64/Linux CI runners this env var is unnecessary and should
 * not be set.
 */

/*
 * The 3-genome createdb test database only yields 3 pairwise core/accessory
 * distance points (3 choose 2 pairs). PopPUNK's default `bgmm` fit tries a
 * 2-component Gaussian mixture (`--K 2`), which is numerically unstable on
 * so few points and crashes with
 * `ValueError: Fitting the mixture model failed because some components
 * have ill-defined empirical covariance (...singleton or collapsed
 * samples)`. Restricting to a single component (`--K 1`) fits a single
 * Gaussian instead, which is stable on this tiny test dataset. This is a
 * test-data-size limitation, not a module bug.
 */
process {
    withName: 'POPPUNK_FITMODEL' {
        ext.args = 'bgmm --K 1'
    }
}
