/*
 * `mamba env create` (the default conda frontend Nextflow picks when invoked
 * via the `mamba` profile) blocks forever inside `mamba::Console::prompt()`
 * waiting on a confirmation read from stdin that Nextflow's subprocess pipe
 * never supplies, when spawned as a Nextflow child process (confirmed via
 * process backtrace sampling; reproduces even though Nextflow already passes
 * `--yes`). This affected both the `+mamba` and default `+conda` profiles on
 * this machine.
 *
 * `micromamba` does not exhibit this hang and resolves the exact same
 * environment.yml correctly and quickly, so it's used here instead.
 */
conda.useMicromamba = true

/*
 * With default QC thresholds, `poppunk --qc-db` can prune most/all samples
 * from the small 3-genome createdb test database, after which poppunk's own
 * plotting code crashes on the near-empty distance matrix
 * (ValueError: zero-size array to reduction operation maximum). This is an
 * upstream poppunk fragility, not a module bug. `--no-plot` avoids the
 * plotting crash; the relaxed distance/ambiguity thresholds keep all three
 * unrelated test genomes from being pruned by QC on this tiny dataset.
 */
process {
    withName: 'POPPUNK_QCDB' {
        ext.args = '--no-plot --max-a-dist 1 --max-pi-dist 1 --max-zero-dist 1'
    }
}
