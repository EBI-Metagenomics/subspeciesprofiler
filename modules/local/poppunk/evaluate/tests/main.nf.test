nextflow_process {

    name "Test Process POPPUNK_EVALUATE"
    script "../main.nf"
    process "POPPUNK_EVALUATE"

    tag "modules"
    tag "modules_local"
    tag "poppunk"
    tag "poppunk/evaluate"

    test("evaluate clusters - fastani") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', model:'bgmm_test' ],
                    file("${projectDir}/tests/fixtures/eval/model", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/eval/fastani.txt", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/eval/labels.csv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(
                    process.out.tool_metrics,
                    process.out.cluster_metrics,
                    process.out.genome_metrics,
                    process.out.findAll { key, val -> key.startsWith("versions") }
                ).match() },
                // the evaluated (non-unword) clusters file, the model name and the binomial decision are present
                { assert path(process.out.tool_metrics[0][1]).text.contains("decision") },
                { assert path(process.out.tool_metrics[0][1]).text.contains("bgmm_test") },
                // the network score is read from the fit dir's *_fit.log (fixture Score = 0.6)
                { assert path(process.out.tool_metrics[0][1]).readLines()[0].split('\t')[1] == 'poppunk_network_score' },
                { assert path(process.out.tool_metrics[0][1]).readLines()[1].split('\t')[1] == '0.6' }
            )
        }

    }

    test("evaluate clusters - fastani - stub") {

        options "-stub"

        when {
            process {
                """
                input[0] = [
                    [ id:'test', model:'bgmm_test' ],
                    file("${projectDir}/tests/fixtures/eval/model", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/eval/fastani.txt", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/eval/labels.csv", checkIfExists: true),
                    []
                ]
                """
            }
        }

        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }

    }


    test("evaluate clusters - apss") {

        when {
            process {
                """
                input[0] = [
                    [ id:'test', model:'syntracker_leiden_apss0.75_r0.5' ],
                    file("${projectDir}/tests/fixtures/eval/model/test_clusters.csv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/eval/fastani.txt", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/eval/labels.csv", checkIfExists: true),
                    [ file("${projectDir}/tests/fixtures/eval/avg_synteny_scores_all_regions.csv", checkIfExists: true) ]
                ]
                """
            }
        }

        then {
            def header = path(process.out.tool_metrics[0][1].toString()).readLines()[0].tokenize('\t')
            assertAll(
                { assert process.success },
                // APSS rows: no PopPUNK network score; noise and ANI-concordance columns before decision
                { assert !header.contains('poppunk_network_score') },
                { assert header[-7..-1] == [ 'apss_se', 'median_silhouette_ANI_HQ', 'negative_silhouette_ANI_HQ_fraction',
                                             'ani_separated_fraction', 'signal', 'decision', 'eval_summary' ] },
                { assert snapshot(
                    process.out.tool_metrics,
                    process.out.cluster_metrics,
                    process.out.genome_metrics
                ).match() }
            )
        }

    }
}
