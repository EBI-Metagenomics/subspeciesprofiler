nextflow_workflow {

    name "Test Subworkflow SYNTRACKER_METHODS"
    script "../main.nf"
    workflow "SYNTRACKER_METHODS"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "syntracker_methods"

    // Stub runs: verify the wiring (HQ genomes -> seqkit N50 + FastANI centrality -> reference and
    // targets -> SynTracker, in chunk pairs for large target sets -> merged APSS -> Leiden sweep ->
    // APSS evaluation). Scientific behaviour is covered by the module tests and
    // tests/bin/test_syntracker_*.py. Fixture: 5 HQ genomes (the select stub takes the targets from
    // the FastANI names, since the seqkit stub writes no N50).
    test("select reference -> syntracker -> leiden sweep -> apss evaluate - wiring - stub") {

        options "-stub"

        when {
            params {
                syntracker_resolutions = '0.5,1.0'
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    ( 1..5 ).collect { file("${projectDir}/tests/fixtures/syntracker/chunked/genomes/genome\${it}.fna.gz", checkIfExists: true) },
                    file("${projectDir}/tests/fixtures/syntracker/chunked/rfile.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/chunked/labels.csv", checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/chunked/fastani.txt", checkIfExists: true)
                ])
                """
            }
        }

        then {
            // default --syntracker_min_apss auto: the stub uses floors 0.800 and 0.900
            def models  = [ '0.800', '0.900' ].collectMany { t -> [ '0.5', '1.0' ].collect { r -> "syntracker_leiden_apss${t}_r${r}" } }
            def genomes = ( 1..5 ).collect { "genome${it}" }
            assertAll(
                { assert workflow.success },
                // one reference genome per species (stub: the first HQ genome)
                { assert workflow.out.reference.size() == 1 },
                { assert workflow.out.reference.get(0).get(1).toString().endsWith('genome1.fna.gz') },
                { assert workflow.out.selection.size() == 1 },
                // 5 targets <= 2 x the default chunk size: one SynTracker job on every target
                { assert workflow.out.runs.size() == 1 },
                { assert workflow.out.runs.get(0).get(0).chunk == 'all' },
                { assert workflow.out.apss.size() == 1 },
                { assert path(workflow.out.apss.get(0).get(1).toString()).readLines().size() == 1 + 10 },
                { assert workflow.out.merge_report.size() == 1 },
                // one clustering table per (min_apss, resolution), each evaluated once in APSS space
                { assert workflow.out.clusters.size() == 1 },
                { assert workflow.out.clusters.get(0).get(1).size() == models.size() },
                { assert workflow.out.coverage.size() == 1 },
                { assert workflow.out.noise.size() == 1 },
                { assert workflow.out.floors.size() == 1 },
                { assert workflow.out.tool_metrics.size() == models.size() },
                { assert workflow.out.tool_metrics.collect { it[0].model }.toSet() == models.toSet() },
                // the downstream meta carries no chunk keys
                { assert workflow.out.tool_metrics.every { !it[0].containsKey('chunk') } },
                // APSS rows carry the ANI-concordance signal
                { assert workflow.out.tool_metrics.collect { path(it[1].toString()).readLines()[0].tokenize('\t') }.every { 'signal' in it } },
                // every HQ genome is a target (no dereplication)
                { assert path(workflow.out.clusters.get(0).get(1)[0].toString()).readLines().drop(1)*.tokenize(',')*.get(0) == genomes }
            )
        }

    }

    test("chunked syntracker - three chunks, three chunk-pair jobs, one merged table - stub") {

        options "-stub"

        when {
            params {
                syntracker_resolutions = '1.0'
                syntracker_chunk_size  = 2
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    ( 1..5 ).collect { file("${projectDir}/tests/fixtures/syntracker/chunked/genomes/genome\${it}.fna.gz", checkIfExists: true) },
                    file("${projectDir}/tests/fixtures/syntracker/chunked/rfile.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/chunked/labels.csv", checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/chunked/fastani.txt", checkIfExists: true)
                ])
                """
            }
        }

        then {
            // 5 targets, chunk size 2 -> 3 chunks, round-robin in target order: {1,4} {2,5} {3}
            def jobs = workflow.out.runs.collectEntries { meta, files ->
                def all = [ files ].flatten().find { it.toString().endsWith('avg_synteny_scores_all_regions.csv') }
                [ meta.chunk, path(all.toString()).readLines().drop(1).collect { it.tokenize(',')[1..2]*.replace('"', '').sort() } as Set ]
            }
            def merged = path(workflow.out.apss.get(0).get(1).toString()).readLines().drop(1)
                .collect { it.tokenize(',')[1..2]*.replace('"', '').sort() }
            assertAll(
                { assert workflow.success },
                { assert jobs.keySet() == [ 'c1_c2', 'c1_c3', 'c2_c3' ] as Set },
                { assert jobs['c1_c2'] == [ [ 'genome1', 'genome4' ], [ 'genome1', 'genome2' ], [ 'genome1', 'genome5' ],
                                            [ 'genome2', 'genome4' ], [ 'genome4', 'genome5' ], [ 'genome2', 'genome5' ] ] as Set },
                { assert jobs['c2_c3'].size() == 3 },
                // one merged table holding every pair of the 5 targets exactly once
                { assert workflow.out.apss.size() == 1 },
                { assert merged.size() == 10 },
                { assert merged.toSet().size() == 10 },
                { assert !workflow.out.apss.get(0).get(0).containsKey('chunk') },
                // clustering and evaluation run once per species, not per job
                { assert workflow.out.clusters.size() == 1 },
                { assert workflow.out.noise.size() == 1 },
                { assert workflow.out.tool_metrics.size() == 2 }
            )
        }

    }

    test("chunked syntracker - a missing chunk job drops the species with a warning - stub") {

        options "-stub"
        config "./missing_chunk.config"

        when {
            params {
                syntracker_resolutions = '1.0'
                syntracker_chunk_size  = 2
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test' ],
                    ( 1..5 ).collect { file("${projectDir}/tests/fixtures/syntracker/chunked/genomes/genome\${it}.fna.gz", checkIfExists: true) },
                    file("${projectDir}/tests/fixtures/syntracker/chunked/rfile.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/syntracker/chunked/labels.csv", checkIfExists: true)
                ])
                input[1] = Channel.of([
                    [ id:'test' ],
                    file("${projectDir}/tests/fixtures/syntracker/chunked/fastani.txt", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                // the run goes on: the other jobs finish, nothing is merged or clustered for the species
                { assert workflow.success },
                { assert workflow.out.runs.collect { it[0].chunk }.toSet() == [ 'c1_c2', 'c2_c3' ] as Set },
                { assert workflow.out.apss.size() == 0 },
                { assert workflow.out.clusters.size() == 0 },
                { assert workflow.out.tool_metrics.size() == 0 },
                // and says which job is missing (log.warn goes to the Nextflow log)
                { assert file("${launchDir}/meta/nextflow.log").text.contains("1 of 3 SynTracker jobs failed after retries (c1_c3)") }
            )
        }

    }

}
