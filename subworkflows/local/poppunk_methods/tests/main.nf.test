nextflow_workflow {

    name "Test Subworkflow POPPUNK_METHODS"
    script "../main.nf"
    workflow "POPPUNK_METHODS"

    tag "subworkflows"
    tag "subworkflows_local"
    tag "poppunk_methods"

    // Stub run: verifies the wiring (Stage 0 -> sweep fan-out -> fit -> dbscan refine -> evaluate
    // -> select) connects and that every fit produces exactly one evaluation. Scientific
    // correctness is covered by the individual module tests (which use real data).
    test("model sweep + dbscan refine - wiring - stub") {

        options "-stub"

        when {
            workflow {
                """
                input[0] = Channel.of([
                    // n_genomes < poppunk_bgmm_max_genomes (200), so the BGMM family is swept
                    [ id:'test', n_genomes: 120 ],
                    [
                        file("${projectDir}/tests/fixtures/genomes/E_coli/genome1.fna.gz", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/genomes/E_coli/genome2.fna.gz", checkIfExists: true)
                    ],
                    file("${projectDir}/tests/fixtures/poppunk_rfile.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/eval/labels.csv", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // 3 threshold (quantiles stub) + 7 bgmm K + 16 dbscan (4 D x 4 mcp)
                // = 26 swept fits, plus a standard refine of each of the 16 dbscan fits,
                // = 42 evaluations in total.
                { assert workflow.out.tool_metrics.size() == 42 },
                // select emits one best model + the accepted-models set for the species
                { assert workflow.out.best_model.size() == 1 },
                { assert workflow.out.best_model.get(0).get(0) == 'test' },
                { assert workflow.out.accepted_models.size() == 1 },
                // Microreact runs for every Strong or Moderate fit. The evaluate stub rates
                // refine_from_* Strong and bgmm_* Moderate, so 16 + 7 = 23 visualisations.
                { assert workflow.out.microreact.size() == 23 },
                // the model name must be carried in the filename (they all land in one directory)
                { assert workflow.out.microreact.every { meta, f -> file(f.toString()).name.contains(meta.model) } }
            )
        }

    }

    // A species at or above --poppunk_bgmm_max_genomes skips the BGMM family entirely; threshold,
    // dbscan and the dbscan refinement are unaffected.
    test("large species skips the bgmm sweep - stub") {

        options "-stub"

        when {
            params {
                poppunk_bgmm_max_genomes = 200
            }
            workflow {
                """
                input[0] = Channel.of([
                    [ id:'test', n_genomes: 500 ],
                    [
                        file("${projectDir}/tests/fixtures/genomes/E_coli/genome1.fna.gz", checkIfExists: true),
                        file("${projectDir}/tests/fixtures/genomes/E_coli/genome2.fna.gz", checkIfExists: true)
                    ],
                    file("${projectDir}/tests/fixtures/poppunk_rfile.tsv", checkIfExists: true),
                    file("${projectDir}/tests/fixtures/eval/labels.csv", checkIfExists: true)
                ])
                """
            }
        }

        then {
            assertAll(
                { assert workflow.success },
                // 42 minus the 7 BGMM fits that are no longer fitted = 35
                { assert workflow.out.tool_metrics.size() == 35 },
                // and no bgmm_* fit reached the evaluator
                { assert workflow.out.tool_metrics.every { meta, tsv -> !meta.model.startsWith('bgmm') } },
                { assert workflow.out.best_model.size() == 1 },
                // with no BGMM (Moderate) fits, only the 16 Strong refine_from_* fits are visualised
                { assert workflow.out.microreact.size() == 16 }
            )
        }

    }

}
